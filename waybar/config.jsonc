{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 8,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "custom/gpu-temp", "custom/gpu-usage", "custom/cpu-temp", "cpu", "memory", "pulseaudio"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },

  "clock": {
    "format": "{:%H:%M  |  %d.%m.%Y}",
    "tooltip": false
  },

  "custom/gpu-temp": {
    "exec": "~/.config/waybar/scripts/gpu-temp.sh",
    "interval": 3,
    "tooltip": false
  },

  "custom/gpu-usage": {
    "exec": "~/.config/waybar/scripts/gpu-usage.sh",
    "interval": 2,
    "tooltip": false
  },

  "custom/cpu-temp": {
    "exec": "~/.config/waybar/scripts/cpu-temp.sh",
    "interval": 3,
    "tooltip": false
  },

  "cpu": {
    "format": "CPU {usage}%",
    "interval": 2
  },

  "memory": {
    "format": "RAM {}%",
    "interval": 5
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTE",
    "on-click": "pavucontrol"
  }
}
