* {
    background-color: #ffffff;
    text-color: #171717;
}

window {
    width: 600px;
    padding: 20px;
    background-color: #ffffff;
    border: 1px solid;
    border-color: #e0e0e0;
    border-radius: 16px;
}

mainbox {
    spacing: 12px;
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 12px;
    background-color: #f2f2f2;
    border-radius: 10px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: #171717;
    background-color: transparent;
}

entry {
    text-color: #171717;
    background-color: transparent;
}

listview {
    lines: 7;
    spacing: 5px;
    background-color: transparent;
    scrollbar: false;
}

element {
    padding: 10px;
    border-radius: 8px;
    background-color: transparent;
    text-color: #171717;
}

element selected {
    background-color: #171717;
    text-color: #ffffff;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

element-icon {
    background-color: transparent;
    size: 24px;
}

configuration {
    show-icons: true;
    icon-theme: "Papirus";
}
